{
  "displayName": "Decoy QuickNode Reserve Usage Elevated",
  "documentation": {
    "content": "The Decoy Seed watcher used QuickNode reserve repeatedly. This usually means the normal batch source is degraded and paid reserve usage is increasing. Check decoy-watcher logs and QuickNode usage.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "enabled": true,
  "conditions": [
    {
      "displayName": "10 or more reserve-use runs in 15 minutes",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/decoy_quicknode_reserve_used\" AND resource.type=\"cloud_run_revision\"",
        "aggregations": [
          {
            "alignmentPeriod": "900s",
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 9,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "notificationChannels": [
    "projects/decoywallet-a283b/notificationChannels/11575546428005095301",
    "projects/decoywallet-a283b/notificationChannels/8194423537344343054"
  ]
}
